# ─────────────────────────────────────────────────────────────────────────────
# CARA QA Runner — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (QA Automation DB) ─────────────────────────────────────────────
# Option A — single DSN (recommended)
DATABASE_URL=postgresql://cara_user:cara_pass@localhost:5434/cara_automation_db

# Option B — individual vars (used only if DATABASE_URL is not set)
# PGHOST=localhost
# PGPORT=5434
# PGDATABASE=cara_automation_db
# PGUSER=cara_user
# PGPASSWORD=cara_pass

# ── OpenAI (PRD Analyzer) ─────────────────────────────────────────────────────
# Required for /prd/* endpoints (PRD → Requirements → Test Cases pipeline)
OPENAI_API_KEY=sk-...
# Optional overrides:
# OPENAI_BASE_URL=https://api.openai.com/v1
# PRD_MODEL=gpt-4o
# PRD_MAX_TOKENS=4096

# ── CARA Backend ──────────────────────────────────────────────────────────────
CARA_BACKEND_URL=http://localhost:9090

# ── QA Runner API ─────────────────────────────────────────────────────────────
QA_RUNNER_PORT=3001

# ── Intent Map ────────────────────────────────────────────────────────────────
# Path to agent_tool_intent_map.json — auto-discovered if left blank
# CARA_INTENT_MAP_PATH=./agent_tool_intent_map.json

# ── Voice E2E Suite ───────────────────────────────────────────────────────────
# CARA_SUITE_TIMEOUT_weather=120
# CARA_SUITE_RETRIES=2
# E2E_JUDGE_CONFIDENCE_THRESHOLD=0.70
